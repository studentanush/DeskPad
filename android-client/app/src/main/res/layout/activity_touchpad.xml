<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Connection & Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_disconnected"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensitivityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.2x"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:hint="@string/host_hint"
            android:textSize="14sp"
            android:inputType="text"
            android:text="127.0.0.1" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:hint="@string/port_hint"
            android:textSize="14sp"
            android:inputType="number"
            android:text="5000" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disconnect"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Sensitivity Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sensitivity_label"
            android:textSize="13sp"
            android:paddingEnd="8dp" />

        <SeekBar
            android:id="@+id/sensitivitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="280"
            android:progress="100" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/instructions"
        android:textSize="11sp"
        android:textColor="#546E7A"
        android:paddingBottom="6dp" />

    <!-- Main Touchpad Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.cnl.touchpad.android.TouchpadView
            android:id="@+id/touchpadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/touchpad_bg"
            android:contentDescription="Touchpad area" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🖱️ TOUCHPAD SURFACE\n1-Finger: Aim &amp; Tap to Click\n2-Fingers: Scroll &amp; Right-Click\nTap-Hold: Drag Selection"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#90A4AE"
            android:textStyle="italic"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <!-- Dedicated Physical-Style Mouse Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnLeftClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:text="@string/left_click"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMiddleClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/middle_click"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRightClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.5"
            android:text="@string/right_click"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
